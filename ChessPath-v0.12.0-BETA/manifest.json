{
  "manifest_version": 3,
  "name": "ChessPath — Opening Explorer BETA",
  "version": "0.12.0",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Explore chess openings as a branching map with move hints and private Friend Play.",
  "action": {
    "default_title": "Open ChessPath",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' wss://chesspath-multiplayer.chesspath-play.workers.dev"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "version_name": "0.12 Beta",
  "short_name": "ChessPath"
}